+// GoldLeaf - [DSN-1] verify mavenLocal bytecode-api freshness against sibling monorepo sources
+val verifyBytecodeApiFreshness = tasks.register("verifyBytecodeApiFreshness") {
+    group = "verification"
+    description = "Verifies mavenLocal bytecode-api:3.3.3 is present and newer than parent api/bytecode-api sources."
+    val m2Jar = file("${System.getProperty("user.home")}/.m2/repository/io/github/leafcraftdev/bytecode-api/3.3.3/bytecode-api-3.3.3.jar")
+    val parentSrc = rootProject.layout.projectDirectory.file("../api/bytecode-api/src/main/java").asFile
+    doLast {
+        if (!m2Jar.isFile) {
+            throw GradleException(
+                "Missing mavenLocal artifact ${m2Jar.absolutePath}. Run `./gradlew :bytecode-api:publishToMavenLocal` in the parent RTP repo first."
+            )
+        }
+        if (parentSrc.isDirectory) {
+            val newestSrc = parentSrc.walkTopDown()
+                .filter { it.isFile && it.extension == "java" }
+                .maxOfOrNull { it.lastModified() } ?: 0L
+            if (newestSrc > m2Jar.lastModified() + 1000L) {
+                throw GradleException(
+                    "Stale mavenLocal bytecode-api:3.3.3 (${m2Jar.absolutePath}) is older than ../api/bytecode-api/src/main/java. " +
+                        "Run `./gradlew :bytecode-api:publishToMavenLocal` in the parent RTP repo first."
+                )
+            }
+        }
+    }
+}
+
+// GoldLeaf - native C11 JNI OpenCL bridge (dlopen libOpenCL.so.1, zero build-time OpenCL headers)
+val goldLeafNativeOutDir = layout.buildDirectory.dir("native")
+val goldLeafNativeLibFile = goldLeafNativeOutDir.map { it.file("libgoldleaf_opencl.so") }
+val goldLeafNativeSrcFile = layout.projectDirectory.file("native/goldleaf_opencl.c")
+val goldLeafJava25Launcher = project.javaToolchains.launcherFor {
+    languageVersion.set(JavaLanguageVersion.of(25))
+}
+
+val compileGoldLeafOpenClNative = tasks.register("compileGoldLeafOpenClNative") {
+    group = "build"
+    description = "Compiles native/goldleaf_opencl.c into libgoldleaf_opencl.so when gcc is available on Linux."
+    inputs.file(goldLeafNativeSrcFile)
+    outputs.file(goldLeafNativeLibFile)
+    val srcFile = goldLeafNativeSrcFile.asFile
+    val outFileProvider = goldLeafNativeLibFile
+    val launcherProvider = goldLeafJava25Launcher
+    val gcc = file("/usr/bin/gcc")
+    doLast {
+        val osName = System.getProperty("os.name").lowercase()
+        if (!osName.contains("linux")) {
+            return@doLast
+        }
+        if (!gcc.canExecute()) {
+            return@doLast
+        }
+        val javaHome = launcherProvider.get().metadata.installationPath.asFile
+        val jniInclude = javaHome.resolve("include")
+        val jniLinuxInclude = jniInclude.resolve("linux")
+        val outFile = outFileProvider.get().asFile
+        outFile.parentFile.mkdirs()
+        val proc = ProcessBuilder(
+            gcc.absolutePath,
+            "-O2", "-shared", "-fPIC", "-Wall", "-Wextra",
+            "-I${jniInclude.absolutePath}",
+            "-I${jniLinuxInclude.absolutePath}",
+            srcFile.absolutePath,
+            "-ldl", "-lpthread",
+            "-o", outFile.absolutePath
+        ).redirectErrorStream(true).start()
+        val output = proc.inputStream.bufferedReader().readText()
+        val exitCode = proc.waitFor()
+        if (exitCode != 0) {
+            throw GradleException("gcc failed compiling goldleaf_opencl.c (exit=$exitCode):\n$output")
+        }
+    }
+}
+
+tasks.named("compileJava") {
+    dependsOn(verifyBytecodeApiFreshness)
+}
+
+tasks.named<Copy>("processResources") {
+    dependsOn(compileGoldLeafOpenClNative)
+    from(goldLeafNativeOutDir) {
+        include("libgoldleaf_opencl.so")
+        into("META-INF/native/linux-x86_64")
+    }
+}
+
