+                        totalElapsedS,
+                        tick.thread.getName(),
+                        true,
+                        threadInfo != null ? threadInfo.getStackTrace() : null
+                    );
+                }
+                // Paper end - lock-free, fault-isolated region-context watchdog diagnostics SPI
