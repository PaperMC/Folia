@@ -773,7 +773,17 @@ public final class RegionizedPlayerChunkLoader {
             }
 
             // try to push more chunk generations
-            final long maxGens = Math.max(0L, Math.min(MAX_RATE, Math.min(this.genQueue.size(), this.getMaxChunkGenerates())));
+            final long baseMaxGens = Math.max(0L, Math.min(MAX_RATE, Math.min(this.genQueue.size(), this.getMaxChunkGenerates())));
+            // GoldLeaf start - ADR-012 per-player chunk-gen backpressure (zero effect below saturation watermark)
+            final long paperNowNanos = System.nanoTime();
+            final long maxGens = ca.spottedleaf.moonrise.spi.ChunkLoadBackpressureSpi.evaluateOrDefault(
+                this.player.getUUID(),
+                this.genQueue.size() + this.generatingQueue.size(),
+                baseMaxGens,
+                this.lastSendDistance,
+                paperNowNanos
+            );
+            // GoldLeaf end - ADR-012 per-player chunk-gen backpressure
             final long maxGensThisTick = this.chunkGenerateTicketLimiter.takeAllocation(maxGens);
             long ratedGensThisTick = 0L;
             while (!this.genQueue.isEmpty()) {
@@ -804,6 +814,15 @@ public final class RegionizedPlayerChunkLoader {
                 );
                 this.generatingQueue.enqueue(chunkKey);
             }
+            // Paper start - record actual ungenerated-chunk debt (excludes pre-generated disk reads)
+            if (ratedGensThisTick > 0L) {
+                ca.spottedleaf.moonrise.spi.ChunkLoadBackpressureSpi.recordNewChunkGenerationsIfPresent(
+                    this.player.getUUID(),
+                    (int) Math.min(Integer.MAX_VALUE, ratedGensThisTick),
+                    paperNowNanos
+                );
+            }
+            // Paper end - record actual ungenerated-chunk debt
             // take the allocations we actually used
             this.chunkGenerateTicketLimiter.returnUnused(maxGensThisTick - ratedGensThisTick);
 
