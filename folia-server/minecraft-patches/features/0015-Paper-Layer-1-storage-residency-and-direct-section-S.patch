     private void changeEntityChunkStatus(final FullChunkStatus toStatus) {
+        boolean hydratedDeferred = false;
+        if (this.entityChunk == null) {
+            if (toStatus != FullChunkStatus.ENTITY_TICKING
+                && ca.spottedleaf.moonrise.spi.LazyEntityHydrationSpi.shouldDeferEntityHydration(this.world, this.chunkX, this.chunkZ)) {
+                return;
+            }
+            if (this.isEntityChunkNBTLoaded()) {
+                this.loadInEntityChunk(false);
+            } else {
+                this.scheduler.chunkHolderManager.getOrCreateEntityChunk(this.chunkX, this.chunkZ, false);
+            }
+            hydratedDeferred = true;
+        } else if (toStatus == FullChunkStatus.ENTITY_TICKING && this.entityChunk.isTransient()) {
+            if (this.isEntityChunkNBTLoaded()) {
+                this.loadInEntityChunk(false);
+            } else {
+                this.scheduler.chunkHolderManager.getOrCreateEntityChunk(this.chunkX, this.chunkZ, false);
+            }
+            hydratedDeferred = true;
+        }
         ((ChunkSystemServerLevel)this.world).moonrise$getEntityLookup().chunkStatusChange(this.chunkX, this.chunkZ, toStatus);
+        if (hydratedDeferred && this.entityChunk != null) {
+            org.bukkit.craftbukkit.event.CraftEventFactory.callEntitiesLoadEvent(
+                this.world, new ChunkPos(this.chunkX, this.chunkZ), this.entityChunk.getAllEntities()
+            );
+        }
+    }
+
+    /**
+     * Hysteresis entity re-freeze for downgraded outer-ring exploration chunks ({@code goldleaf-ADR-005} Stage 4).
+     * Persists dirty entity state asynchronously via {@link #saveEntities}, unloads eligible passive
+     * entities from {@code EntityLookup}, and parks the serialized snapshot in {@code pendingEntityChunk}
+     * so future {@code ENTITY_TICKING} promotion or {@code Chunk#getEntities()} re-hydrates transparently.
+     */
+    public boolean paper$tryRefreezeEntityChunk() {
+        TickThread.ensureTickThread(this.world, this.chunkX, this.chunkZ, "Cannot refreeze entity chunk off-main");
+        if (this.unloaded || this.processingFullStatus) {
+            return false;
+        }
+        if (this.currentFullChunkStatus == FullChunkStatus.ENTITY_TICKING
+            || this.pendingFullChunkStatus == FullChunkStatus.ENTITY_TICKING
+            || this.currentFullChunkStatus == FullChunkStatus.INACCESSIBLE) {
+            return false;
+        }
+        final ChunkEntitySlices slices = this.entityChunk;
+        if (slices == null || slices.isTransient() || slices.isPreventingStatusUpdates()) {
+            return false;
+        }
+        final List<net.minecraft.world.entity.Entity> entities = slices.getAllEntities();
+        for (int i = 0, len = entities.size(); i < len; ++i) {
+            final net.minecraft.world.entity.Entity entity = entities.get(i);
+            if (entity.isRemoved()) {
+                continue;
+            }
+            if (!entity.shouldBeSaved()
+                || entity instanceof net.minecraft.world.entity.player.Player
+                || entity.isVehicle()
+                || entity.isPassenger()
+                || (entity instanceof net.minecraft.world.entity.Leashable leashable && leashable.isLeashed())
+                || entity instanceof net.minecraft.world.entity.boss.enderdragon.EnderDragon
+                || entity instanceof net.minecraft.world.entity.boss.wither.WitherBoss) {
+                return false;
+            }
+        }
+
+        // Persist any mutations asynchronously before unloading live NMS Entity objects (S-004, S-005)
+        this.saveEntities(slices, false, null);
+        final CompoundTag frozen = slices.save();
+        final boolean hasTransient = slices.unload();
+        if (!hasTransient) {
+            ((ChunkSystemServerLevel)this.world).moonrise$getEntityLookup().entitySectionUnload(this.chunkX, this.chunkZ);
+        }
+        final ReentrantAreaLock.Node schedulingLock = this.scheduler.schedulingLockArea.lock(this.chunkX, this.chunkZ);
+        try {
+            if (this.unloaded) {
+                return false;
+            }
+            if (hasTransient) {
+                slices.setTransient(true);
+                this.entityChunk = slices;
+            } else {
+                this.entityChunk = null;
+            }
+            this.pendingEntityChunk = frozen == null ? EMPTY_ENTITY_CHUNK : frozen;
+        } finally {
+            this.scheduler.schedulingLockArea.unlock(schedulingLock);
+        }
+        return true;
     }
 
     private boolean processingFullStatus = false;
