     private static void freeBytes(final byte[] bytes) {
+        if (bytes == null || bytes == SHARED_FULL_BYTES) {
+            return;
+        }
         WORKING_BYTES_POOL.get().addFirst(bytes);
     }
 
+    /**
+     * Constructs a {@link SWMRNibbleArray} from loaded NBT light bytes, sharing a single immutable
+     * {@code 0xFF} singleton when all 4,096 nibbles are full (15) to avoid duplicate {@code byte[2048]}
+     * heap allocations across sunlit air sections.
+     */
+    public static SWMRNibbleArray fromLoadedBytes(final byte[] bytes, final int state) {
+        if (bytes == null) {
+            return new SWMRNibbleArray(null, state);
+        }
+        if (bytes == SHARED_FULL_BYTES) {
+            return new SWMRNibbleArray(SHARED_FULL_BYTES, state);
+        }
+        if (bytes.length != ARRAY_SIZE) {
+            throw new IllegalArgumentException("Data of wrong length: " + bytes.length);
+        }
+        if (isAllFull(bytes)) {
+            return new SWMRNibbleArray(SHARED_FULL_BYTES, state);
+        }
+        return new SWMRNibbleArray(bytes.clone(), state);
+    }
+
+    /**
+     * Returns a lightweight {@link DataLayer} wrapping the immutable {@code 0xFF} singleton for
+     * zero-allocation direct `.lca` full-skylight loading. Callers must never mutate the returned
+     * {@code DataLayer}; {@link #fromLoadedBytes} recognizes {@code SHARED_FULL_BYTES} by identity.
+     */
+    public static net.minecraft.world.level.chunk.DataLayer createSharedFullDataLayer() {
+        return new net.minecraft.world.level.chunk.DataLayer(SHARED_FULL_BYTES);
+    }
+
+    public static boolean isSharedFullBacking(final SWMRNibbleArray array) {
+        return array != null && array.storageVisible == SHARED_FULL_BYTES;
+    }
+
     public static SWMRNibbleArray fromVanilla(final DataLayer nibble) {
         if (nibble == null) {
             return new SWMRNibbleArray(null, true);
@@ -168,6 +214,18 @@ public final class SWMRNibbleArray {
