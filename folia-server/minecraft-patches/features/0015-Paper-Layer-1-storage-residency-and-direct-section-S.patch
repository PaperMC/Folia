+                tickingBlocks.setMinCapacity(Math.min(this.tickingBlockCount * 3 / 2 + 1, 16 * 16 * 16));
+                coldBacking.forEachMatchingCoordinate(BlockState::isRandomlyTicking, (final int pos12) -> tickingBlocks.add((short) pos12));
+            }
+            return;
+        }
+        // GoldLeaf end - ADR-005 Stage 4 cold-section block counting without SimpleBitStorage unpack
