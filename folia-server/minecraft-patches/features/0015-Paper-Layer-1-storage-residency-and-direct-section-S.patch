+    // GoldLeaf - shared immutable 0xFF nibble array for uniform full-skylight sections (ADR-005 Stage 4)
+    private static final byte[] SHARED_FULL_BYTES = createSharedFullBytes();
+
+    private static byte[] createSharedFullBytes() {
+        final byte[] full = new byte[ARRAY_SIZE];
+        Arrays.fill(full, (byte)0xFF);
+        return full;
+    }
