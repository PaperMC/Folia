+
+    // GoldLeaf start - Wave 4 heightmap-guided skylight column propagator
+    private void tryPropagateSkylightFromSurface(
+        final BlockGetter world,
+        final int worldX,
+        final int startY,
+        final int worldZ,
+        final int surfaceFirstAirY,
+        final int safeSkipAboveY
+    ) {
+        final int encodeOffset = this.coordinateOffset;
+        final long propagateDirection = AxisDirection.POSITIVE_Y.everythingButThisDirection;
+        final int chunkX = worldX >> 4;
+        final int chunkZ = worldZ >> 4;
+        final int minY = this.minLightSection << 4;
+        final int airFloor = Math.max(surfaceFirstAirY, minY);
+
+        int y = startY;
+        while (y >= airFloor) {
+            final int sectionY = y >> 4;
+            this.checkNullSection(chunkX, sectionY, chunkZ, false);
+            final SWMRNibbleArray nibble = this.getNibbleFromCache(chunkX, sectionY, chunkZ);
+            final int sectionBottom = Math.max(sectionY << 4, airFloor);
+            if (nibble == null) {
+                y = (sectionY << 4) - 1;
+                continue;
+            }
+            final int lx = worldX & 15;
+            final int lz = worldZ & 15;
+            final int localIndexBase = lx | (lz << 4);
+            for (int cy = y; cy >= sectionBottom; --cy) {
+                nibble.set(localIndexBase | ((cy & 15) << 8), 15);
+                if (cy <= safeSkipAboveY) {
+                    this.appendToIncreaseQueue(
+                        ((worldX + (worldZ << 6) + (cy << (6 + 6)) + encodeOffset) & ((1L << (6 + 6 + 16)) - 1))
+                            | (15L << (6 + 6 + 16))
+                            | (propagateDirection << (6 + 6 + 16 + 4))
+                    );
+                }
+            }
+            y = sectionBottom - 1;
+        }
+        if (y >= minY) {
+            this.tryPropagateSkylight(world, worldX, y, worldZ, false, false);
+        }
+    }
+    // GoldLeaf end - Wave 4 heightmap-guided skylight column propagator
 }
