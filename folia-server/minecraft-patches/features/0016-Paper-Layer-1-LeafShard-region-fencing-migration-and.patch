+    // Paper start - per-region dirty-voxel halo buffer for multi-node sharding SPI
+    private long[] dirtyVoxelChunkKeys;
+    private int[] dirtyVoxelSectionYs;
+    private int[] dirtyVoxelPackedCells;
+    private int dirtyVoxelCount;
+
+    public void recordDirtyVoxelHalo(
+        final int chunkX,
+        final int chunkZ,
+        final int sectionY,
+        final int localPos12,
+        final int runtimeStateId
+    ) {
+        final io.papermc.paper.threadedregions.spi.DirtyVoxelHaloSink sink =
+            io.papermc.paper.threadedregions.spi.DirtyVoxelHaloSink.get();
+        if (sink == null) {
+            return;
+        }
+        final int packed = io.papermc.paper.threadedregions.spi.DirtyVoxelHaloSink.packDirtyVoxel(localPos12, runtimeStateId);
+        sink.recordDirtyVoxel(this.world, chunkX, chunkZ, sectionY, packed);
+        if (this.dirtyVoxelPackedCells == null) {
+            this.dirtyVoxelChunkKeys = new long[64];
+            this.dirtyVoxelSectionYs = new int[64];
+            this.dirtyVoxelPackedCells = new int[64];
+        } else if (this.dirtyVoxelCount >= this.dirtyVoxelPackedCells.length) {
+            final int nextCap = this.dirtyVoxelPackedCells.length << 1;
+            this.dirtyVoxelChunkKeys = Arrays.copyOf(this.dirtyVoxelChunkKeys, nextCap);
+            this.dirtyVoxelSectionYs = Arrays.copyOf(this.dirtyVoxelSectionYs, nextCap);
+            this.dirtyVoxelPackedCells = Arrays.copyOf(this.dirtyVoxelPackedCells, nextCap);
+        }
+        final int idx = this.dirtyVoxelCount++;
+        this.dirtyVoxelChunkKeys[idx] = CoordinateUtils.getChunkKey(chunkX, chunkZ);
+        this.dirtyVoxelSectionYs[idx] = sectionY;
+        this.dirtyVoxelPackedCells[idx] = packed;
+    }
+
+    public void flushDirtyVoxelHalo(final long regionId) {
+        if (this.dirtyVoxelCount == 0) {
+            return;
+        }
+        final int count = this.dirtyVoxelCount;
+        this.dirtyVoxelCount = 0;
+        final io.papermc.paper.threadedregions.spi.DirtyVoxelHaloSink sink =
+            io.papermc.paper.threadedregions.spi.DirtyVoxelHaloSink.get();
+        if (sink != null) {
+            sink.flushRegionHalo(
+                this.world,
+                regionId,
+                this.dirtyVoxelChunkKeys,
+                this.dirtyVoxelSectionYs,
+                this.dirtyVoxelPackedCells,
+                count
+            );
+        }
+    }
+
+    private long[] residencyTickEndKeys;
+
+    public void flushResidencyTickEnd() {
+        final ca.spottedleaf.moonrise.spi.ChunkResidencySpi spi = ca.spottedleaf.moonrise.spi.ChunkResidencySpi.get();
+        if (spi == null) {
+            return;
+        }
+        final int count = this.chunks.size();
+        if (count == 0) {
+            return;
+        }
+        long[] keys = this.residencyTickEndKeys;
+        if (keys == null || keys.length < count) {
+            keys = new long[Math.max(64, count)];
+            this.residencyTickEndKeys = keys;
+        }
+        final Object[] raw = this.chunks.getRawDataUnchecked();
+        for (int i = 0; i < count; i++) {
+            final LevelChunk chunk = (LevelChunk) raw[i];
+            keys[i] = CoordinateUtils.getChunkKey(chunk.getPos().x(), chunk.getPos().z());
+        }
+        spi.onRegionTickEnd(this.world.dimension().identifier().toString(), keys, count);
+    }
+    // Paper end - per-region dirty-voxel halo buffer for multi-node sharding SPI
