+    private static int playerGive(
+        final CommandSourceStack source,
+        final Collection<ServerPlayer> players,
+        final List<ItemStack> drops,
+        final LootCommand.Callback callback
+    ) throws CommandSyntaxException {
+        final List<ItemStack> usedItems = Collections.synchronizedList(Lists.newArrayListWithCapacity(drops.size()));
+        final AtomicInteger remaining = new AtomicInteger(players.size());
+
+        for (ServerPlayer player : players) {
+            final List<ItemStack> playerDrops = copyItemStacks(drops);
+            if (!player.getBukkitEntity().taskScheduler.schedule(
+                scheduledPlayer -> {
+                    final ServerPlayer currentPlayer = (ServerPlayer)scheduledPlayer;
+                    for (ItemStack drop : playerDrops) {
+                        if (currentPlayer.getInventory().add(drop.copy())) {
+                            usedItems.add(drop.copy());
+                        }
+                    }
+                    finishOutput(source, callback, usedItems, remaining);
+                },
+                retiredPlayer -> finishOutput(source, callback, usedItems, remaining),
+                1L
+            )) {
+                finishOutput(source, callback, usedItems, remaining);
+            }
+        }
 
-        for (ItemStack drop : drops) {
-            for (ServerPlayer player : players) {
-                if (player.getInventory().add(drop.copy())) {
-                    usedItems.add(drop);
+        return players.size();
+    }
+
+    private static void finishOutput(
+        final CommandSourceStack source,
+        final LootCommand.Callback callback,
+        final List<ItemStack> usedItems,
+        final AtomicInteger remaining
+    ) {
+        if (remaining.decrementAndGet() == 0) {
+            try {
+                final List<ItemStack> result;
+                synchronized (usedItems) {
+                    result = List.copyOf(usedItems);
                 }
+                callback.accept(result);
+            } catch (final CommandSyntaxException exception) {
+                sendFailure(source, exception);
             }
         }
+    }
 
-        callback.accept(usedItems);
-        return usedItems.size();
