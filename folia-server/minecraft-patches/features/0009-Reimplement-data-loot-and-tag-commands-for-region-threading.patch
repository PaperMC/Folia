+            source.getLevel(),
+            pos.getX() >> 4,
+            pos.getZ() >> 4,
+            () -> {
+                try {
+                    action.run();
+                } catch (final CommandSyntaxException exception) {
+                    sendFailure(source, exception);
+                }
+            }
+        );
+    }
