+    // Aetheria start - Create an Identifier in the aetheria namespace
+    public static Identifier withAetheriaNamespace(String location) {
+        return new Identifier("aetheria", assertValidPath("aetheria", location));
+    }
+    // Aetheria start - Create an Identifier in the aetheria namespace
+
     public static @Nullable Identifier tryParse(String location) {
         return tryBySeparator(location, ':');
     }
