             .collect(Collectors.toUnmodifiableList());
         RegistryOps.RegistryInfoLookup registryInfoLookup = createContext(registryLookups, list);
         list.forEach(loader -> loadingFunction.apply((RegistryDataLoader.Loader<?>)loader, registryInfoLookup));
+        // Aetheria start - Register Aetheria objects in data-driven registries
+        list.forEach(loader -> {
+            final WritableRegistry<?> registry = loader.registry();
+
+            if  (registry.key().equals(Registries.DIMENSION_TYPE)) {
+                AetheriaDimensionTypes.bootstrap((WritableRegistry<DimensionType>) registry, registryInfoLookup);
+            } else if (registry.key().equals(Registries.LEVEL_STEM)) {
+                AetheriaLevelStems.bootstrap((WritableRegistry<LevelStem>) registry, registryInfoLookup);
+            }
+        });
+        // Aetheria end - Register Aetheria objects in data-driven registries
