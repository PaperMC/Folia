+    // GoldLeaf start - sub-tick immediate entity task scheduling (ADR-002)
+    /**
+     * Schedules a task for immediate sub-tick execution on the region owning this entity.
+     * Re-checks ownership and retirement on the owning region thread before invocation; falls back
+     * to the next entity tick if the entity is currently detached or transferring between regions.
+     */
+    public boolean scheduleImmediate(final Consumer<? extends Entity> run, final Consumer<? extends Entity> retired) {
+        Objects.requireNonNull(run, "Run task may not be null");
+
+        final ScheduledTask task = new ScheduledTask(run, retired);
+        synchronized (this.stateLock) {
+            if (this.tickCount == RETIRED_TICK_COUNT) {
+                return false;
+            }
+            this.immediateTasks.add(task);
+            if (!this.insideScheduledList && this.scheduledList != null) {
+                this.scheduledList.add(this);
+                this.insideScheduledList = true;
+            }
+        }
+
+        final Entity handle = this.entity.getHandleRaw();
+        if (handle != null && handle.level() instanceof net.minecraft.server.level.ServerLevel serverLevel) {
+            final net.minecraft.world.level.ChunkPos chunkPos = handle.chunkPosition();
+            RegionizedServer.getInstance().taskQueue.queueTickTaskQueue(
+                serverLevel,
+                chunkPos.x(),
+                chunkPos.z(),
+                this::drainImmediateTasks,
+                ca.spottedleaf.concurrentutil.util.Priority.HIGHER
+            );
+        }
+
+        return true;
+    }
+
+    /**
+     * Drains queued immediate tasks if the calling thread currently owns this entity and it is not
+     * retired. Re-routes to the entity's current chunk if ownership moved before this callback ran.
+     */
+    public void drainImmediateTasks() {
+        final Entity thisEntity = this.entity.getHandleRaw();
+        if (thisEntity == null) {
+            return;
+        }
+        if (!TickThread.isTickThreadFor(thisEntity)) {
+            if (!this.isRetiredOffThread() && !this.immediateTasks.isEmpty()
+                && thisEntity.level() instanceof net.minecraft.server.level.ServerLevel serverLevel) {
+                final net.minecraft.world.level.ChunkPos chunkPos = thisEntity.chunkPosition();
+                RegionizedServer.getInstance().taskQueue.queueTickTaskQueue(
+                    serverLevel,
+                    chunkPos.x(),
+                    chunkPos.z(),
+                    this::drainImmediateTasks,
+                    ca.spottedleaf.concurrentutil.util.Priority.HIGHER
+                );
+            }
+            return;
+        }
+
+        ScheduledTask task;
+        while ((task = this.immediateTasks.poll()) != null) {
+            if (this.tickCount == RETIRED_TICK_COUNT) {
+                final Consumer<Entity> retireTask = (Consumer<Entity>)task.retired;
+                if (retireTask != null) {
+                    retireTask.accept(thisEntity);
+                }
+                continue;
+            }
+            if (!TickThread.isTickThreadFor(thisEntity)) {
+                this.immediateTasks.add(task);
+                break;
+            }
+            ((Consumer<Entity>)task.run).accept(thisEntity);
+        }
+    }
+    // GoldLeaf end - sub-tick immediate entity task scheduling (ADR-002)
+
     /**
      * Executes a tick for the scheduler.
      *
@@ -236,6 +329,10 @@ public final class EntityScheduler {
