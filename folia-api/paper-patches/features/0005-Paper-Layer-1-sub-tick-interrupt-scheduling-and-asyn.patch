diff --git a/src/main/java/io/papermc/paper/threadedregions/scheduler/AsyncReadRouter.java b/src/main/java/io/papermc/paper/threadedregions/scheduler/AsyncReadRouter.java
new file mode 100644
index 0000000000000000000000000000000000000000..3cc3a5a486011c84638e2aee013f52a88c88e3a5
--- /dev/null
+++ b/src/main/java/io/papermc/paper/threadedregions/scheduler/AsyncReadRouter.java
@@ -0,0 +1,108 @@
+package io.papermc.paper.threadedregions.scheduler;
+
+import org.jetbrains.annotations.NotNull;
+
+import java.util.Objects;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.Executor;
+import java.util.function.Consumer;
+import java.util.function.Supplier;
+
+/**
+ * Generic async-first read/dispatch router SPI.
+ *
+ * <p>Decouples read-heavy subsystems and plugins from the 20 TPS tick cadence by executing
+ * read workloads off-tick and dispatching state-mutating continuations onto the target region or
+ * global immediate executor. Ships with a default fallback ({@link DefaultAsyncReadRouter}) and
+ * allows server implementations or extensions to register latency-tiered routers.</p>
+ */
+public interface AsyncReadRouter {
+
+    /**
+     * Submits a read-only supplier to run asynchronously on {@code asyncExecutor}, failing closed
+     * by propagating any exception onto the returned future.
+     *
+     * @param asyncReader   The read-only supplier to execute off-tick.
+     * @param asyncExecutor The async executor to run the read on.
+     * @param <T>           The read result type.
+     * @return A future completing with the read result or failing with any thrown exception.
+     */
+    <T> @NotNull CompletableFuture<T> submitAsyncRead(
+        @NotNull Supplier<T> asyncReader,
+        @NotNull Executor asyncExecutor
+    );
+
+    /**
+     * Executes {@code asyncReader} on {@code asyncExecutor}, then dispatches {@code regionConsumer}
+     * onto {@code targetRegionExecutor} and completes the returned future with the read value once
+     * the region continuation finishes.
+     *
+     * @param asyncReader          The read-only supplier to execute off-tick.
+     * @param asyncExecutor        The async executor to run the read on.
+     * @param regionConsumer       The continuation to run on {@code targetRegionExecutor}.
+     * @param targetRegionExecutor The target region/entity/global executor.
+     * @param <T>                  The read result type.
+     * @return A future completing with the read value once {@code regionConsumer} completes.
+     */
+    <T> @NotNull CompletableFuture<T> readAndDispatch(
+        @NotNull Supplier<T> asyncReader,
+        @NotNull Executor asyncExecutor,
+        @NotNull Consumer<T> regionConsumer,
+        @NotNull Executor targetRegionExecutor
+    );
+
+    static @NotNull AsyncReadRouter get() {
+        return Holder.current;
+    }
+
+    static void register(final @NotNull AsyncReadRouter router) {
+        Holder.current = Objects.requireNonNull(router, "router");
+    }
+
+    static void resetDefault() {
+        Holder.current = DefaultAsyncReadRouter.INSTANCE;
+    }
+
+    final class Holder {
+        private static volatile AsyncReadRouter current = DefaultAsyncReadRouter.INSTANCE;
+
+        private Holder() {
+        }
+    }
+
+    /**
+     * Default implementation using standard {@link CompletableFuture} stages.
+     */
+    final class DefaultAsyncReadRouter implements AsyncReadRouter {
+
+        public static final DefaultAsyncReadRouter INSTANCE = new DefaultAsyncReadRouter();
+
+        private DefaultAsyncReadRouter() {
+        }
+
+        @Override
+        public <T> @NotNull CompletableFuture<T> submitAsyncRead(
+            final @NotNull Supplier<T> asyncReader,
+            final @NotNull Executor asyncExecutor
+        ) {
+            Objects.requireNonNull(asyncReader, "asyncReader");
+            Objects.requireNonNull(asyncExecutor, "asyncExecutor");
+            return CompletableFuture.supplyAsync(asyncReader, asyncExecutor);
+        }
+
+        @Override
+        public <T> @NotNull CompletableFuture<T> readAndDispatch(
+            final @NotNull Supplier<T> asyncReader,
+            final @NotNull Executor asyncExecutor,
+            final @NotNull Consumer<T> regionConsumer,
+            final @NotNull Executor targetRegionExecutor
+        ) {
+            Objects.requireNonNull(regionConsumer, "regionConsumer");
+            Objects.requireNonNull(targetRegionExecutor, "targetRegionExecutor");
+            return this.submitAsyncRead(asyncReader, asyncExecutor).thenApplyAsync(value -> {
+                regionConsumer.accept(value);
+                return value;
+            }, targetRegionExecutor);
+        }
+    }
+}
