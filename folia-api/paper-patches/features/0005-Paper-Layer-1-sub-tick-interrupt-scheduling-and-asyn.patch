+    /**
+     * Schedules a strictly read-only task to execute at the next clean mid-tick phase boundary on the
+     * region owning the chunk (under a bounded micro-budget), falling back to {@link #execute} when
+     * the region is not currently active or when mid-tick drains are unsupported.
+     *
+     * <p>Tasks submitted here <strong>must not</strong> mutate world, block, or entity state.</p>
+     *
+     * @param plugin The plugin that owns the task
+     * @param world  The world of the region that owns the task
+     * @param chunkX The chunk X coordinate of the region that owns the task
+     * @param chunkZ The chunk Z coordinate of the region that owns the task
+     * @param run    The strictly read-only task to execute
+     */
+    default void executeReadOnlyMidTick(@NotNull Plugin plugin, @NotNull World world, int chunkX, int chunkZ, @NotNull Runnable run) {
+        this.execute(plugin, world, chunkX, chunkZ, run);
+    }
+
+    /**
+     * Schedules a strictly read-only query to execute at the next clean mid-tick phase boundary on the
+     * region owning the chunk, returning a future completed with the query result.
+     *
+     * @param plugin The plugin that owns the task
+     * @param world  The world of the region that owns the task
+     * @param chunkX The chunk X coordinate of the region that owns the task
+     * @param chunkZ The chunk Z coordinate of the region that owns the task
+     * @param query  The strictly read-only query to execute
+     * @param <T>    The query result type
+     * @return A future completed with the query result or failed if the query throws
+     */
+    default <T> @NotNull CompletableFuture<T> submitReadOnlyMidTick(
+        @NotNull Plugin plugin,
+        @NotNull World world,
+        int chunkX,
+        int chunkZ,
+        @NotNull Supplier<T> query
+    ) {
+        final CompletableFuture<T> future = new CompletableFuture<>();
+        this.executeReadOnlyMidTick(plugin, world, chunkX, chunkZ, () -> {
+            try {
+                future.complete(query.get());
+            } catch (final Throwable t) {
+                future.completeExceptionally(t);
+            }
+        });
+        return future;
+    }
+
